# Public (baked into the browser bundle at build time)
NEXT_PUBLIC_APP_URL=https://ruxs.in
NEXT_PUBLIC_HEXCLAVE_API_URL=https://api.hexclave.com
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=afdff151-7a3c-49b3-830f-abfcc23d8d61

# Secrets: put real values in .env (local) / .dev.vars (wrangler) / `wrangler secret put`
HEXCLAVE_SECRET_SERVER_KEY=
DATABASE_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CRON_SECRET=
# Admins are rows in the platform_admins table, managed at /admin/settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local Hyperdrive binding for `next dev` (point at a Neon dev branch)
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
