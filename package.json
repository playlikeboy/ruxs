{
  "name": "ruxs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "bun test src tests",
    "test:e2e": "playwright test",
    "db:migrate:fresh": "bun scripts/migrate-fresh.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "postinstall": "node scripts/patch-opennext.cjs && node scripts/build-hexclave-css.mjs",
    "db:seed:storefronts": "bun run src/db/seed-storefronts.ts",
    "db:seed:vendor-types": "bun run src/db/seed-vendor-types.ts"
  },
  "dependencies": {
    "@animateicons/react": "0.12.0",
    "@hexclave/next": "1.0.125",
    "@opennextjs/cloudflare": "1.20.10",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.54.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
